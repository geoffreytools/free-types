{
    "name": "free-types",
    "version": "1.0.0-alpha.0",
    "description": "A type-level library enabling the creation and the manipulation of type constructors which are detached from their type parameters.",
    "keywords:": [
        "higher kinded type",
        "type constructor",
        "typescript"
    ],
    "type": "module",
    "types": "./index.d.ts",
    "main": "./index.js",
    "files": [
        "./core/**/*",
        "./essential/**/*",
        "./experimental/**/*",
        "./utility-types/**/*",
        "./index.js",
        "./index.d.ts",
        "./TypesMap.js",
        "./TypesMap.d.ts"
    ],
    "author": "Geoffrey Gourdet",
    "repository": {
        "type": "git",
        "url": "https://github.com/geoffreyTools/free-types"
    },
    "license": "ICS",
    "devDependencies": {
        "foo": "github:geoffreytools/foo",
        "ts-spec": "^1.7.0",
        "ts-trace": "github:geoffreytools/ts-trace",
        "tsc-esm-kit": "github:geoffreytools/tsc-esm-kit#v0.3.0",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "test": "npm run build && tsc",
        "test watch": "tsc --watch",
        "build": "tsc -p ./tsconfig-build.json && tsc-esm-kit --project ./tsconfig-build.json --files",
        "build perf": "tsc -p ./tsconfig-build-perf.json",
        "diagnostics": "tsc -p ./tsconfig-perf.json --extendedDiagnostics",
        "build watch": "tsc -p ./tsconfig-build.json --watch",
        "trace": "bash ./node_modules/ts-trace/ts-trace.sh -i ./tsconfig-perf.json"
    },
    "dependencies": {
        "free-types-core": "^1.0.3"
    }
}
