{
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "src/*": [
                "./src/*"
            ],
        },
        "noEmit": true,
        "noEmitOnError": true,
        "noErrorTruncation": true,
        "moduleResolution": "node",
        "module": "ES2020",
        "strictFunctionTypes": true,
        "noImplicitAny": true,
        "strict": true
    }
}